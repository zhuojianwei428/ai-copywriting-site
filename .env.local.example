# 复制本文件为 .env.local 并填入你的真实值
DEEPSEEK_API_KEY=sk-XXXXXXXXXXXXXXXX

# Supabase Auth（登录功能，见下方配置说明）
# 到 https://supabase.com 建项目后，点右上角 Connect → App Frameworks 复制下面两个值：
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# 新版控制台叫 publishable key（值形如 sb_publishable_xxx）；旧版叫 anon key（值形如 eyJxxx）。
# 代码两者都认，填哪个都行（只需填一个）：
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXX
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJXXXXXXXXXXXXXXXX
# 注意：publishable / anon key 都是公开 key（配合 RLS 使用，非 secret），必须用 NEXT_PUBLIC_ 前缀供前端读取；
# 但 DEEPSEEK_API_KEY 是 secret，绝不能加 NEXT_PUBLIC_。
# 同理，Supabase 的 service_role / secret key 也绝不能加 NEXT_PUBLIC_。

# 可选覆盖项：
# DEEPSEEK_MODEL=deepseek-v4-flash
#   注意：deepseek-chat / deepseek-reasoner 已于 2026-07-24 停用，调用会直接报错。
#   现役模型：deepseek-v4-flash（默认，便宜）/ deepseek-v4-pro（约 3 倍价格）。
# DEEPSEEK_BASE_URL=https://api.deepseek.com
#
# 成本防护（均可选项，括号中为默认值）：
# MAX_INPUT_CHARS=6000            # 单次请求输入字符上限，超出返回 413
# MAX_OUTPUT_TOKENS=1600          # 单次生成最大输出 token（7 部分完整绩效表需 ~1300）
# DAILY_CALL_WARN_THRESHOLD=500   # 单日调用次数告警阈值，达到即在日志输出 WARN
#
# 安全约束：DEEPSEEK_* 一律不得以 NEXT_PUBLIC_ 开头，只能作为服务端环境变量存在；
# 唯一例外是 NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#（Supabase 前端 key 设计上就是给浏览器的，真正的访问控制靠 RLS 策略）。

